{
  "name": "edex-ui",
  "productName": "eDEX-UI",
  "version": "3.0.0-alpha.1",
  "description": "A science fiction desktop running everywhere. Awesome.",
  "keywords": [
    "desktop",
    "sci-fi",
    "gui",
    "portable",
    "tty",
    "terminal"
  ],
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w node-pty",
    "dev": "vite",
    "build": "vite build",
    "package": "vite build && electron-builder",
    "package-linux": "vite build && electron-builder build -l --x64 --arm64",
    "package-darwin": "vite build && electron-builder build -m",
    "package-windows": "vite build && electron-builder build -w",
    "start": "vite",
    "init-file-icons": "git submodule update --init",
    "update-file-icons": "git submodule foreach git pull origin master && node file-icons-generator.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitSquared/edex-ui.git"
  },
  "author": "Gabriel 'Squared' SAILLARD <gabriel@saillard.dev> (https://gaby.dev)",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/GitSquared/edex-ui/issues"
  },
  "homepage": "https://github.com/GitSquared/edex-ui#readme",
  "build": {
    "appId": "com.edex.ui",
    "productName": "eDEX-UI",
    "publish": "github",
    "asar": true,
    "compression": "normal",
    "copyright": "Copyright © 2017-2026 Gabriel 'Squared' SAILLARD <gabriel@saillard.dev> (https://gaby.dev)",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets",
        "filter": [
          "audio/**",
          "fonts/**",
          "themes/**",
          "kb_layouts/**",
          "misc/**",
          "icons/**"
        ]
      }
    ],
    "forceCodeSigning": false,
    "npmRebuild": true,
    "artifactName": "eDEX-UI-${os}-${arch}.${ext}",
    "linux": {
      "target": [ "AppImage" ],
      "category": "System",
      "icon": "media/linuxIcons"
    },
    "appImage": {
      "artifactName": "eDEX-UI-Linux-${arch}.AppImage"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities",
      "icon": "media/icon.icns"
    },
    "dmg": {
      "artifactName": "eDEX-UI-macOS-${arch}.dmg"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "media/icon.ico"
    },
    "nsis": {
      "artifactName": "eDEX-UI-Windows-${arch}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "dependencies": {
    "color": "3.2.1",
    "geolite2-redist": "^2.0.4",
    "howler": "2.2.3",
    "maxmind": "4.3.2",
    "mime-types": "^2.1.35",
    "nanoid": "3.1.30",
    "node-pty": "0.10.1",
    "pdfjs-dist": "2.11.338",
    "pretty-bytes": "5.6.0",
    "shell-env": "3.0.1",
    "signale": "1.4.0",
    "smoothie": "1.35.0",
    "systeminformation": "5.9.7",
    "tail": "2.2.4",
    "username": "5.1.0",
    "which": "2.0.2",
    "ws": "7.5.5",
    "xterm": "4.14.1",
    "xterm-addon-attach": "0.6.0",
    "xterm-addon-fit": "0.5.0",
    "xterm-addon-ligatures": "0.5.1",
    "xterm-addon-webgl": "^0.11.2"
  },
  "devDependencies": {
    "augmented-ui": "^1.1.2",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0"
  },
  "optionalDependencies": {
    "cson-parser": "4.0.9",
    "osx-temperature-sensor": "1.0.7"
  }
}
